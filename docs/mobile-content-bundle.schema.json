{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pythonclouds.ru/schemas/mobile-content-bundle-v2.json",
  "title": "Python в облаках — mobile content bundle v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_version",
    "content_hash",
    "python_runtime",
    "topics"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "content_version": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "python_runtime": { "const": "3.14.x" },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/topic" }
    }
  },
  "$defs": {
    "richBlock": {
      "type": ["object", "null"],
      "properties": {
        "text": { "type": "string" },
        "example": { "type": ["string", "null", "object"] },
        "goal": { "type": "string" },
        "concepts": { "type": "array", "items": { "type": "string" } },
        "explanation": { "type": "string" },
        "application": { "type": "string" },
        "lead": { "type": "string" },
        "sections": { "type": "array" },
        "mistakes": { "type": "array" },
        "applications": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "array", "items": { "type": "string" } },
        "title": { "type": "string" },
        "prev": { "type": ["string", "null"] },
        "next": { "type": ["string", "null"] },
        "id": { "type": "integer" }
      },
      "required": ["text"],
      "additionalProperties": true
    },
    "quizQuestion": {
      "type": "object",
      "required": ["prompt", "answer", "wrong"],
      "properties": {
        "prompt": { "type": "string" },
        "answer": { "type": "string" },
        "wrong": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "explanation": { "type": "string" }
      },
      "additionalProperties": true
    },
    "check": {
      "type": ["object", "null"],
      "properties": {
        "append": { "type": "string" },
        "expect": { "type": "string" }
      },
      "required": ["expect"],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "type", "title", "prompt", "code", "code_language", "answer",
        "answer_language", "explanation", "verified", "hint", "intro", "check",
        "wrong", "questions"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "type": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "prompt": { "type": "string", "minLength": 1 },
        "code": { "type": ["string", "null"] },
        "code_language": { "type": "string" },
        "answer": { "type": "string", "minLength": 1 },
        "answer_language": { "type": "string" },
        "explanation": { "type": "string", "minLength": 1 },
        "verified": { "type": "string" },
        "hint": { "type": ["string", "null"] },
        "intro": { "$ref": "#/$defs/richBlock" },
        "check": { "$ref": "#/$defs/check" },
        "wrong": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "questions": {
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/quizQuestion" }
        }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "level", "level_label", "description", "theory", "tasks"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "level": { "enum": ["beginner", "intermediate", "advanced", "expert"] },
        "level_label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "theory": { "$ref": "#/$defs/richBlock" },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/task" }
        }
      }
    }
  }
}
